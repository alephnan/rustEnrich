# Non-secret overrides read by Docker Compose. rustenrich itself reads the
# process environment only; it does not automatically load this file.
# Complete settings and units: SPEC.md section 6.
ENRICH_ABUSEIPDB_ENABLED=true
ENRICH_LOG_LEVEL=info
ENRICH_ABUSEIPDB_MAX_AGE_DAYS=30
ENRICH_ABUSEIPDB_MAX_CONCURRENCY=4
ENRICH_ABUSEIPDB_REQUESTS_PER_MINUTE=0
ENRICH_ABUSEIPDB_REQUESTS_PER_DAY=1000

# Used only when compose.virustotal.yaml is included with -f.
ENRICH_VIRUSTOTAL_ENABLED=true
ENRICH_VIRUSTOTAL_MAX_CONCURRENCY=4
ENRICH_VIRUSTOTAL_REQUESTS_PER_MINUTE=4
ENRICH_VIRUSTOTAL_REQUESTS_PER_DAY=500

# Compose mounts operator-created files from ./secrets/ read-only. Do not put
# credentials in this file or commit them. The service token must be 32+ bytes.
# ./secrets/service_token
# ./secrets/abuseipdb_api_key
# ./secrets/virustotal_api_key (only with the VirusTotal overlay)
